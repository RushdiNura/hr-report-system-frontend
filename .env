# Base URL of the backend API (no trailing slash), e.g.:
#   http://localhost:5000/api        (local dev)
#   https://hr-report-system-backend.onrender.com/api   (production)
VITE_API_URL=https://hr-report-system-backend.onrender.com/api 

# Base URL of the backend for Socket.io and static file downloads
# (same host as above, without the /api suffix)
VITE_SERVER_URL=https://hr-report-system-backend.onrender.com
